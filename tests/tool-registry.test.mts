const marker = "// GENERATED by scripts/generate-tools.mts. Do not edit.";
const routeMarker = `${marker}\n// Owner: robot-tools`;
const entry = (id = "fixture", folder = "text/fixture-tool") => ({
  id,
  category: "text",
  folder,
  available: true,
  hidden: false,
});
const manifest = () => ({
  label: { en: "Fixture Tool", cs: "Testovací nástroj" },
  status: "tested",
  featureFlags: { preview: true },
  openRouter: { envName: "OPENROUTER_FIXTURE_API_KEY" },
  routes: [
    {
      path: "/api/fixture",
      handler: "code/server",
      methods: ["GET", "POST"],
      dynamic: "force-dynamic",
      runtime: "nodejs",
      revalidate: false,
      maxDuration: 300,
    },
  ],
  assets: [
    { source: "public/example.txt", publicPath: "/fixture/example.txt" },
  ],
});
const modelDefinitions = () => [
  {
    stageId: "planner",
    label: { en: "Fixture planning", cs: "Testovací plánování" },
    defaultModel: "fixture/planner",
    environmentPrecedence: ["OPENROUTER_FIXTURE_PLAN_MODEL"],
    failureFallbackModels: [
      { defaultModel: "fixture/fallback", environmentPrecedence: [] },
    ],
    data: { en: "Fixture input", cs: "Testovací vstup" },
    providerNotes: { en: "Fixture provider", cs: "Testovací poskytovatel" },
  },
];
async function put(root: string, path: string, content: string) {
  const target = resolve(root, path);
  await mkdir(dirname(target), { recursive: true });
  await writeFile(target, content);
}
async function release(root: string, entries = [entry()]) {
  await put(
    root,
    "app/_tools/registry.ts",
    `export const appRegistryEntries = ${JSON.stringify(entries)} as const;\n`,
  );
}
async function owner(root: string, folder: string, data = manifest()) {
  const base = `app/_tools/${folder}`;
  await put(
    root,
    `${base}/manifest.ts`,
    `import type { ToolManifest } from "../../types";\nexport default ${JSON.stringify(data)} satisfies ToolManifest;`,
  );
  await put(
    root,
    `${base}/model-definitions.ts`,
    `import type { ModelStageDefinition } from "../../models.ts";\nexport const modelDefinitions = ${JSON.stringify(modelDefinitions())} as const satisfies readonly ModelStageDefinition[];`,
  );
  await put(
    root,
    `${base}/Tool.tsx`,
    "export default function Tool() { return null; }",
  );
  for (const language of ["en", "cs"])
    await put(root, `${base}/info.${language}.md`, `# ${language} fixture`);
  await put(
    root,
    `${base}/code/server.ts`,
    'throw new Error("Server must not execute during generation");',
  );
  await put(root, `${base}/public/example.txt`, "fixture asset");
}
async function fixture(t: { after: (fn: () => Promise<void>) => void }) {
  const root = await mkdtemp(resolve(tmpdir(), "robot-tool-registry-"));
  t.after(() => rm(root, { recursive: true, force: true }));
  for (const folder of [
    "text",
    "image",
    "design",
    "design-manual/public",
    "design-manual/images",
  ]) {
    await mkdir(resolve(root, "app/_tools", folder), { recursive: true });
  }
  await release(root);
  await owner(root, "text/fixture-tool");
  return root;
}
const read = (root: string, path: string) =>
  readFile(resolve(root, path), "utf8");

test("new registered owner generates lazy client, pure data, literal API settings, assets and OpenRouter mapping", async (t) => {
  const root = await fixture(t);
  const result = await generateTools({ root });
  assert.equal(result.tools, 1);
  assert.equal(result.routes, 1);
  assert.equal(result.assets, 3);
  const client = await read(root, "app/_tools/generated/registry.client.tsx");
  assert.match(
    client,
    /lazy\(\(\) => import\("\.\.\/text\/fixture-tool\/Tool"\)\)/,
  );
  assert.doesNotMatch(
    client,
    /server|openRouter|process\.|node:|model-definitions|registry\.models|fixture\/planner/,
  );
  const models = await read(root, "app/_tools/generated/registry.models.ts");
  assert.match(models, /import "server-only";/);
  assert.match(
    models,
    /import \{ modelDefinitions as models0 \} from "\.\.\/text\/fixture-tool\/model-definitions";/,
  );
  assert.match(models, /"text\/fixture-tool": models0/);
  assert.doesNotMatch(
    models,
    /\bimport\s*\(|code\/server|process\.|use client|registry\.client/,
  );
  const source = await read(root, "app/_tools/generated/registry.data.ts");
  const javascript = stripTypeScriptTypes(source, { mode: "strip" });
  assert.doesNotMatch(
    javascript,
    /\bimport\b|\brequire\b|process\.|node:|code\/server|model-definitions|registry\.models|fixture\/planner|environmentPrecedence/,
  );
  const data = await import(
    `data:text/javascript;base64,${Buffer.from(javascript).toString("base64")}`
  );
  assert.deepEqual(data.toolDefinitions[0], {
    ...entry(),
    label: manifest().label,
    status: "tested",
    featureFlags: { preview: true },
  });
  assert.deepEqual(data.openRouterApps.fixture, {
    name: "Fixture Tool",
    slug: "fixture-tool",
    envName: "OPENROUTER_FIXTURE_API_KEY",
  });
  const route = await read(root, "app/api/fixture/route.ts");
  assert.ok(route.startsWith(routeMarker));
  assert.match(route, /export const dynamic = "force-dynamic";/);
  assert.match(route, /export const runtime = "nodejs";/);
  assert.match(route, /export const revalidate = false;/);
  assert.match(route, /export const maxDuration = 300;/);
  assert.match(
    route,
    /export \{ GET, POST \} from .*fixture-tool\/code\/server/,
  );
  assert.ok(
    JSON.parse(await read(root, "app/_tools/generated/assets.json")).some(
      (asset: { source: string; publicPath: string }) =>
        asset.source === "app/_tools/text/fixture-tool/public/example.txt" &&
        asset.publicPath === "/fixture/example.txt",
    ),
  );
  assert.deepEqual((await generateTools({ root, check: true })).changed, []);
});

