for (const [name, expression] of [
  ["IIFE", "(() => { globalThis.__robotMetadataExecuted++; return DATA; })()"],
  ["global fetch", '(globalThis.fetch("https://never.invalid"), DATA)'],
  [
    "bracket global fetch",
    '(globalThis["fetch"]("https://never.invalid"), DATA)',
  ],
  ["new constructor", 'new Function("globalThis.__robotMetadataExecuted++")()'],
  ["prototype mutation", "Object.setPrototypeOf(DATA, {})"],
  ["constructor access", "DATA.constructor"],
  ["dynamic import", 'import("node:fs")'],
]) {
  for (const metadataModule of ["manifest", "models", "registry"]) {
    test(`AST interpreter rejects ${metadataModule} ${name} in normal/check mode without executing it`, async (t) => {
      const root = await fixture(t);
      const globals = globalThis as typeof globalThis & {
        __robotMetadataExecuted?: number;
      };
      globals.__robotMetadataExecuted = 0;
      const originalFetch = globalThis.fetch;
      let fetchCalls = 0;
      globalThis.fetch = async () => {
        fetchCalls++;
        return new Response("");
      };
      t.after(() => {
        globalThis.fetch = originalFetch;
        delete globals.__robotMetadataExecuted;
      });
      const value =
        metadataModule === "manifest"
          ? manifest()
          : metadataModule === "models"
            ? modelDefinitions()
            : [entry()];
      const code = expression.replaceAll("DATA", "data");
      const prefix = `const data = ${JSON.stringify(value)};\n`;
      const path =
        metadataModule === "registry"
          ? "app/_tools/registry.ts"
          : `app/_tools/text/fixture-tool/${metadataModule === "models" ? "model-definitions" : "manifest"}.ts`;
      const source =
        prefix +
        (metadataModule === "registry"
          ? `export const appRegistryEntries = ${code};`
          : metadataModule === "models"
            ? `export const modelDefinitions = ${code};`
            : `export default ${code};`);
      await put(root, path, source);
      for (const check of [false, true])
        await assert.rejects(generateTools({ root, check }), /only pure data/);
      assert.equal(globals.__robotMetadataExecuted, 0);
      assert.equal(fetchCalls, 0);
      await assert.rejects(access(resolve(root, "app/_tools/generated")), {
        code: "ENOENT",
      });
      await assert.rejects(access(resolve(root, "public")), { code: "ENOENT" });
    });
  }
}

