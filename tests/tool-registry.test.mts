test("owned links can change their declared source without modifying either source", async (t) => {
  const root = await fixture(t);
  await generateTools({ root });
  const newSource = "app/_tools/text/fixture-tool/public/other.txt";
  await put(root, newSource, "new owned source");
  await replaceAssets(root, [
    { source: "public/other.txt", publicPath: "/fixture/example.txt" },
  ]);
  await assert.rejects(
    generateTools({ root, check: true }),
    /Generated output is stale/,
  );
  assert.equal(await read(root, assetURL), "fixture asset");
