});

test("wrong links are reported in check and are not silently adopted or overwritten", async (t) => {
  const root = await fixture(t);
  await generateTools({ root });
  const ownership = await read(root, markerPath);
  await put(root, "unmanaged.txt", "user data");
  await rm(resolve(root, assetURL));
  await symlink(resolve(root, "unmanaged.txt"), resolve(root, assetURL));
  for (const check of [true, false])
    await assert.rejects(
      generateTools({ root, check }),
      /collision: wrong or unmanaged link/,
    );
  await assert.rejects(
    materializePublicAssets({ root }),
    /collision: wrong or unmanaged link/,
  );
  assert.equal(await read(root, assetURL), "user data");
  assert.equal(await read(root, markerPath), ownership);
});

