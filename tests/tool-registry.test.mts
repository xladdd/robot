test("check detects missing, modified and stale output without mutations", async (t) => {
  const root = await fixture(t);
  await assert.rejects(
    generateTools({ root, check: true }),
    /Generated output is stale/,
  );
  await assert.rejects(access(resolve(root, "app/_tools/generated")), {
    code: "ENOENT",
  });
  await generateTools({ root });
  await put(root, "app/_tools/generated/registry.client.tsx", "drift");
  await put(root, "app/_tools/generated/registry.models.ts", "model drift");
  await put(root, "app/api/stale/route.ts", `${routeMarker}\nexport {};`);
  await assert.rejects(
    generateTools({ root, check: true }),
    /registry.client.tsx.*registry.models.ts.*stale\/route.ts/,
  );
  assert.equal(
    await read(root, "app/_tools/generated/registry.client.tsx"),
    "drift",
  );
  assert.equal(
    await read(root, "app/_tools/generated/registry.models.ts"),
    "model drift",
  );
  await access(resolve(root, "app/api/stale/route.ts"));
  await generateTools({ root });
  assert.deepEqual((await generateTools({ root, check: true })).changed, []);
});

