test("restores manifest maxDuration after route deletion and overrides stale wrapper settings", async (t) => {
  const root = await fixture(t);
  await generateTools({ root });
  const path = "app/api/fixture/route.ts";
  const original = await read(root, path);
  await rm(resolve(root, path));
  await generateTools({ root });
  assert.equal(await read(root, path), original);
  await put(
    root,
    path,
    original.replace("maxDuration = 300", "maxDuration = 60"),
  );
  await assert.rejects(
    generateTools({ root, check: true }),
    /Generated output is stale/,
  );
  await generateTools({ root });
  assert.equal(await read(root, path), original);
  const data = manifest();
  await put(
    root,
    "app/_tools/text/fixture-tool/manifest.ts",
    `export default ${JSON.stringify({ ...data, routes: data.routes.map((route) => ({ ...route, maxDuration: undefined })) })};`,
  );
  await generateTools({ root });
  assert.doesNotMatch(await read(root, path), /maxDuration/);
});
const assetURL = "public/fixture/example.txt";
const assetSource = "app/_tools/text/fixture-tool/public/example.txt";
const markerPath = `public/${assetOwnershipFile}`;
async function replaceAssets(
  root: string,
  assets: Array<{ source: string; publicPath: string }>,
) {
  await put(
    root,
    "app/_tools/text/fixture-tool/manifest.ts",
    `export default ${JSON.stringify({ ...manifest(), assets })};`,
  );
}

test("generation creates live local asset links and adopts matching tracked links", async (t) => {
  const root = await fixture(t);
  await mkdir(resolve(root, "public/fixture"), { recursive: true });
  const target = "../../app/_tools/text/fixture-tool/public/example.txt";
  await symlink(target, resolve(root, assetURL));
  const before = await lstat(resolve(root, assetURL));
  await generateTools({ root });
  assert.equal(await readlink(resolve(root, assetURL)), target);
  assert.equal((await lstat(resolve(root, assetURL))).ino, before.ino);
  assert.equal(
    await realpath(resolve(root, assetURL)),
    resolve(root, assetSource),
  );
  await put(root, assetSource, "changed source, immediately live locally");
  assert.equal(
    await read(root, assetURL),
    "changed source, immediately live locally",
  );
  assert.deepEqual((await generateTools({ root, check: true })).changed, []);
  assert.deepEqual((await generateTools({ root })).changed, []);
});

