    second.routes[0].path = "/api/second";
    second.assets[0].publicPath = "/second/example.txt";
    second.openRouter.envName = "OPENROUTER_SECOND_API_KEY";
    if (kind === "routes") second.routes[0].path = "/api/fixture";
    if (kind === "public URLs")
      second.assets[0].publicPath = "/fixture/example.txt";
    if (kind === "environment variables")
      second.openRouter.envName = "OPENROUTER_FIXTURE_API_KEY";
    await owner(root, "text/second-tool", second);
    await release(root, [
      entry(),
