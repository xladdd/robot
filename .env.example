# Application and authentication
APP_URL=http://localhost:3000
APP_USERS=admin:change-me
AUTH_SECRET=replace-with-a-long-random-secret

# Dedicated server-only OpenRouter inference keys.
# `npm run openrouter:provision` writes these values to .env.local.
OPENROUTER_TEXT_EXTRACTOR_API_KEY=
OPENROUTER_INDEX_CREATOR_API_KEY=
OPENROUTER_GRAPH_GENERATOR_API_KEY=
OPENROUTER_DIAGRAM_GENERATOR_API_KEY=
OPENROUTER_MAP_GENERATOR_API_KEY=
OPENROUTER_COVER_GENERATOR_API_KEY=
OPENROUTER_LAYER_SPLITTER_API_KEY=
OPENROUTER_IMAGE_GENERATOR_API_KEY=
OPENROUTER_GREP_BUILDER_API_KEY=
OPENROUTER_PROMPT_EXTRACTOR_API_KEY=

# Temporary migration fallback used only when an app-specific key is absent.
OPENROUTER_API_KEY=

# Configurable text and structured-output models
OPENROUTER_OCR_MODEL=mistralai/mistral-small-2603
OPENROUTER_CORRECTION_MODEL=mistralai/ministral-8b-2512
OPENROUTER_INDEX_MODEL=mistralai/mistral-medium-3-5
OPENROUTER_GREP_MODEL=mistralai/ministral-8b-2512
OPENROUTER_PROMPT_EXTRACTOR_MODEL=qwen/qwen3.5-122b-a10b
OPENROUTER_FIGURE_MODEL=mistralai/mistral-large-2512

# Image Generator models. The OPENROUTER_COVER_* names are retained for compatibility.
OPENROUTER_COVER_SKETCH_MODEL=black-forest-labs/flux.2-klein-4b
OPENROUTER_COVER_FIDELITY_MODEL=black-forest-labs/flux.2-pro
OPENROUTER_COVER_PRODUCTION_MODEL=black-forest-labs/flux.2-pro
OPENROUTER_IMAGE_UPSCALE_MODEL=black-forest-labs/flux.2-pro

# Layer Splitter models
OPENROUTER_LAYER_SPLITTER_PLAN_MODEL=mistralai/mistral-small-2603
OPENROUTER_LAYER_SPLITTER_FAST_MODEL=black-forest-labs/flux.2-klein-4b
OPENROUTER_LAYER_SPLITTER_FIDELITY_MODEL=black-forest-labs/flux.2-pro
