import {
  lstat,
  mkdir,
  readFile,
  readdir,
  realpath,
  rm,
  writeFile,
} from "node:fs/promises";
import { dirname, isAbsolute, relative, resolve, sep } from "node:path";
import { fileURLToPath } from "node:url";
import ts from "typescript";
import {
  planPublicAssets,
  applyPublicAssets,
} from "./materialize-public-links.mjs";
import type { ToolManifest } from "../app/_tools/types.ts";

const marker = "// GENERATED by scripts/generate-tools.mts. Do not edit.";
const routeMarker = `${marker}\n// Owner: robot-tools`;
const defaultRoot = resolve(dirname(fileURLToPath(import.meta.url)), "..");
const quote = JSON.stringify;

function fail(message: string): never {
  throw new Error(`[generate-tools] ${message}`);
}
function safeRelative(value: string, context: string): string {
  if (
    typeof value !== "string" ||
    !value ||
    isAbsolute(value) ||
    value.includes("\\") ||
    value.split("/").some((part) => !part || part === "." || part === "..") ||
    /[\x00-\x1f?#]/.test(value)
  ) {
    fail(
      `${context}: expected a safe relative path, received ${quote(value)}.`,
    );
  }
  return value;
}
function inside(parent: string, child: string): boolean {
  const path = relative(parent, child);
  return (
    path !== "" &&
    !path.startsWith(`..${sep}`) &&
    path !== ".." &&
    !isAbsolute(path)
  );
}
async function exists(path: string): Promise<boolean> {
  try {
    await lstat(path);
    return true;
  } catch (error) {
    if ((error as NodeJS.ErrnoException).code === "ENOENT") return false;
    throw error;
  }
}
async function requireOwnedFile(root: string, path: string, context: string) {
  if (!(await exists(path)))
    fail(`${context}: missing ${relative(root, path)}.`);
  if (!inside(await realpath(root), await realpath(path)))
    fail(`${context}: path escapes its owning folder.`);
}
async function walk(path: string): Promise<string[]> {
  if (!(await exists(path))) return [];
  const files: string[] = [];
  for (const entry of await readdir(path, { withFileTypes: true })) {
    const child = resolve(path, entry.name);
    if (entry.isDirectory()) files.push(...(await walk(child)));
    else files.push(child);
  }
  return files.sort();
}
type DataValue =
  string | number | boolean | null | DataValue[] | { [key: string]: DataValue };

// Interpret syntax, never import/eval metadata. Only bounded, side-effect-free
// data construction is accepted; no function or object from metadata is invoked.
function readDataModule(
  source: string,
  path: string,
  registryOnly = false,
): Record<string, DataValue> {
  const file = ts.createSourceFile(
    path,
    source,
    ts.ScriptTarget.Latest,
    true,
    ts.ScriptKind.TS,
  );
  const reject = (node: ts.Node, reason: string): never => {
    const { line, character } = file.getLineAndCharacterOfPosition(
      node.getStart(file),
    );
    return fail(
      `${path}:${line + 1}:${character + 1}: metadata must contain only pure data; ${reason}.`,
    );
  };
  const diagnostics = (
    file as ts.SourceFile & { parseDiagnostics: readonly ts.Diagnostic[] }
  ).parseDiagnostics;
  if (diagnostics.length) reject(file, "invalid TypeScript syntax");
  const declarations = new Map<string, ts.Expression>();
  const constants = new Map<string, DataValue>();
  const resolving = new Set<string>();
  const exports: Record<string, DataValue> = Object.create(null);
  const reserved = new Set(["__proto__", "prototype", "constructor"]);
  let steps = 0;
  const key = (value: DataValue, node: ts.Node): string => {
    if (
      (typeof value !== "string" && typeof value !== "number") ||
      reserved.has(String(value))
    )
      reject(node, "unsafe data property");
    return String(value);
  };
  const record = (
    value: DataValue,
    node: ts.Node,
  ): { [key: string]: DataValue } => {
    if (value === null || typeof value !== "object" || Array.isArray(value))
      reject(node, "expected a data object");
    return value as { [key: string]: DataValue };
  };
  const exported = (node: ts.Node) =>
    ts.canHaveModifiers(node) &&
    ts
      .getModifiers(node)
      ?.some((modifier) => modifier.kind === ts.SyntaxKind.ExportKeyword);
  for (const statement of file.statements) {
    if (ts.isVariableStatement(statement)) {
      if (!(statement.declarationList.flags & ts.NodeFlags.Const)) {
        if (registryOnly) continue;
        reject(statement, "only const declarations are allowed");
      }
      for (const declaration of statement.declarationList.declarations) {
        if (!ts.isIdentifier(declaration.name) || !declaration.initializer) {
          if (registryOnly) continue;
          reject(declaration, "expected a named initialized constant");
        }
        const name = (declaration.name as ts.Identifier).text;
        if (declarations.has(name) || name === "Object" || reserved.has(name))
          reject(declaration, "duplicate or reserved constant name");
        declarations.set(name, declaration.initializer!);
      }
    } else if (!registryOnly) {
      if (ts.isImportDeclaration(statement)) {
        const clause = statement.importClause;
        const typeOnly =
          clause?.isTypeOnly ||
          (!clause?.name &&
            clause?.namedBindings &&
            ts.isNamedImports(clause.namedBindings) &&
            clause.namedBindings.elements.length > 0 &&
            clause.namedBindings.elements.every((item) => item.isTypeOnly));
        if (!typeOnly) reject(statement, "runtime imports are forbidden");
      } else if (ts.isExportAssignment(statement)) {
        if (statement.isExportEquals)
          reject(statement, "export equals is forbidden");
      } else if (ts.isExportDeclaration(statement)) {
        if (
          !statement.isTypeOnly &&
          (statement.moduleSpecifier ||
            !statement.exportClause ||
            !ts.isNamedExports(statement.exportClause))
        )
          reject(statement, "runtime re-exports are forbidden");
      } else if (
        !ts.isTypeAliasDeclaration(statement) &&
        !ts.isInterfaceDeclaration(statement) &&
        !ts.isEmptyStatement(statement)
      ) {
        reject(statement, "executable statements and functions are forbidden");
      }
    }
  }
  const constant = (name: string, node: ts.Node): DataValue => {
    if (constants.has(name)) return constants.get(name)!;
    const expression = declarations.get(name);
    if (!expression || resolving.has(name))
      reject(node, "unknown global or circular constant reference");
    resolving.add(name);
    const value = evaluate(expression!, new Map(), 0);
    resolving.delete(name);
    constants.set(name, value);
    return value;
  };
  const evaluate = (
    node: ts.Expression,
    locals: Map<string, DataValue>,
    depth: number,
  ): DataValue => {
    if (++steps > 100000 || depth > 100)
      reject(node, "data construction limit exceeded");
    const run = (expression: ts.Expression) =>
      evaluate(expression, locals, depth + 1);
    if (
      ts.isParenthesizedExpression(node) ||
      ts.isAsExpression(node) ||
      ts.isSatisfiesExpression(node) ||
      ts.isTypeAssertionExpression(node)
    )
      return run(node.expression);
    if (ts.isStringLiteral(node) || ts.isNoSubstitutionTemplateLiteral(node))
      return node.text;
    if (ts.isNumericLiteral(node)) {
      const number = Number(node.text);
      if (!Number.isFinite(number)) reject(node, "non-finite number");
      return number;
    }
    if (node.kind === ts.SyntaxKind.TrueKeyword) return true;
    if (node.kind === ts.SyntaxKind.FalseKeyword) return false;
    if (node.kind === ts.SyntaxKind.NullKeyword) return null;
    if (ts.isIdentifier(node))
      return locals.has(node.text)
        ? locals.get(node.text)!
        : constant(node.text, node);
    if (
      ts.isPrefixUnaryExpression(node) &&
      [ts.SyntaxKind.MinusToken, ts.SyntaxKind.PlusToken].includes(
        node.operator,
      )
    ) {
      const value = run(node.operand);
      if (typeof value !== "number")
        reject(node, "unary signs require numeric data");
      return node.operator === ts.SyntaxKind.MinusToken
        ? -(value as number)
        : value;
    }
    if (ts.isArrayLiteralExpression(node)) {
      const result: DataValue[] = [];
      for (const element of node.elements) {
        if (ts.isOmittedExpression(element))
          reject(element, "sparse arrays are forbidden");
        if (ts.isSpreadElement(element)) {
          const value = run(element.expression);
          if (!Array.isArray(value))
            reject(element, "array spread requires array data");
          result.push(...(value as DataValue[]));
        } else result.push(run(element));
      }
      return result;
    }
    if (ts.isObjectLiteralExpression(node)) {
      const result: { [key: string]: DataValue } = Object.create(null);
      for (const property of node.properties) {
        if (ts.isSpreadAssignment(property)) {
          for (const [name, value] of Object.entries(
            record(run(property.expression), property),
          ))
            result[key(name, property)] = value;
        } else if (
          ts.isShorthandPropertyAssignment(property) &&
          !property.objectAssignmentInitializer
        ) {
          result[key(property.name.text, property)] = run(property.name);
        } else if (ts.isPropertyAssignment(property)) {
          const name = property.name;
          const propertyKey = ts.isComputedPropertyName(name)
            ? key(run(name.expression), name)
            : ts.isIdentifier(name) ||
                ts.isStringLiteral(name) ||
                ts.isNumericLiteral(name)
              ? key(name.text, name)
              : reject(name, "invalid property name");
          result[propertyKey] = run(property.initializer);
        } else
          reject(property, "methods, accessors and mutations are forbidden");
      }
      return result;
    }
    if (ts.isTemplateExpression(node)) {
      let text = node.head.text;
      for (const span of node.templateSpans) {
        const value = run(span.expression);
        if (value !== null && typeof value === "object")
          reject(span, "template interpolation must be scalar data");
        text += String(value) + span.literal.text;
      }
      return text;
    }
    if (
      ts.isPropertyAccessExpression(node) ||
      ts.isElementAccessExpression(node)
    ) {
      const value = run(node.expression);
      const property = ts.isPropertyAccessExpression(node)
        ? key(node.name.text, node)
        : key(run(node.argumentExpression), node);
      if (
        value === null ||
        typeof value !== "object" ||
        !Object.hasOwn(value, property)
      )
        reject(node, "only own data properties may be read");
      return (value as { [key: string]: DataValue })[property];
    }
    if (
      ts.isCallExpression(node) &&
      ts.isPropertyAccessExpression(node.expression) &&
      !node.questionDotToken
    ) {
      const access = node.expression;
      const method = access.name.text;
      if (
        ts.isIdentifier(access.expression) &&
        access.expression.text === "Object" &&
        !locals.has("Object")
      ) {
        if (
          node.arguments.length !== 1 ||
          !["values", "entries", "fromEntries"].includes(method)
        )
          reject(node, "Object construction is not allowlisted");
        const value = run(node.arguments[0]);
        if (method === "values") return Object.values(record(value, node));
        if (method === "entries") return Object.entries(record(value, node));
        if (!Array.isArray(value))
          reject(node, "fromEntries requires array data");
        const result: { [key: string]: DataValue } = Object.create(null);
        for (const pair of value as DataValue[]) {
          if (!Array.isArray(pair) || pair.length !== 2)
            reject(node, "fromEntries requires key/value pairs");
          const name = key((pair as DataValue[])[0], node);
          if (Object.hasOwn(result, name))
            reject(node, "duplicate fromEntries key");
          result[name] = (pair as DataValue[])[1];
        }
        return result;
      }
      const arrayValue = run(access.expression);
      if (!Array.isArray(arrayValue))
        reject(node, "only allowlisted array data construction may be called");
      const array = arrayValue as DataValue[];
      if (method === "join" && node.arguments.length <= 1) {
        const separator = node.arguments.length ? run(node.arguments[0]) : ",";
        if (
          typeof separator !== "string" ||
          array.some((value) => value !== null && typeof value === "object")
        )
          reject(node, "join requires scalar data and a string separator");
        return array.join(separator as string);
      }
      if (method === "map" && node.arguments.length === 1) {
        const callback = node.arguments[0];
        if (
          !ts.isArrowFunction(callback) ||
          callback.modifiers?.length ||
          callback.parameters.length !== 1 ||
          ts.isBlock(callback.body)
        )
          reject(
            node,
            "map requires a single-parameter expression-only data projection",
          );
        const parameter = (callback as ts.ArrowFunction).parameters[0];
        if (
          !ts.isIdentifier(parameter.name) ||
          parameter.initializer ||
          parameter.dotDotDotToken ||
          parameter.name.text === "Object" ||
          reserved.has(parameter.name.text)
        )
          reject(node, "invalid map data parameter");
        return array.map((value) => {
          const scope = new Map(locals);
          scope.set((parameter.name as ts.Identifier).text, value);
          return evaluate(
            (callback as ts.ArrowFunction).body as ts.Expression,
            scope,
            depth + 1,
          );
        });
      }
      reject(node, "array operation is not allowlisted");
    }
    return reject(node, "expression is not allowlisted data construction");
  };
  if (registryOnly) {
    const declaration = file.statements
      .filter(ts.isVariableStatement)
      .filter(exported)
      .flatMap((statement) =>
        statement.declarationList.flags & ts.NodeFlags.Const
          ? [...statement.declarationList.declarations]
          : [],
      )
      .find(
        (item) =>
          ts.isIdentifier(item.name) && item.name.text === "appRegistryEntries",
      );
    if (!declaration?.initializer)
      fail(
        "registry.ts must export the const appRegistryEntries release list.",
      );
    exports.appRegistryEntries = constant("appRegistryEntries", declaration);
  } else {
    // Check all constants, including unused ones, so an IIFE cannot hide outside
    // the exported value. Registry helpers are deliberately not interpreted.
    for (const [name, expression] of declarations) constant(name, expression);
    for (const statement of file.statements) {
      if (ts.isVariableStatement(statement) && exported(statement)) {
        for (const declaration of statement.declarationList.declarations)
          exports[(declaration.name as ts.Identifier).text] = constant(
            (declaration.name as ts.Identifier).text,
            declaration,
          );
      } else if (ts.isExportAssignment(statement)) {
        exports.default = evaluate(statement.expression, new Map(), 0);
      } else if (
        ts.isExportDeclaration(statement) &&
        !statement.isTypeOnly &&
        statement.exportClause &&
        ts.isNamedExports(statement.exportClause)
      ) {
        for (const item of statement.exportClause.elements)
          if (!item.isTypeOnly)
            exports[item.name.text] = constant(
              (item.propertyName ?? item.name).text,
              item,
            );
      }
    }
  }
  return exports;
}

async function pureModule(path: string) {
  return readDataModule(await readFile(path, "utf8"), path);
}

function validateModelDefinitions(value: unknown, context: string) {
  const isRecord = (value: unknown): value is Record<string, unknown> =>
    value !== null && typeof value === "object" && !Array.isArray(value);
  const nonempty = (value: unknown): value is string =>
    typeof value === "string" && value.trim().length > 0;
  const bilingual = (value: unknown) =>
    isRecord(value) && nonempty(value.en) && nonempty(value.cs);
  const choice = (value: unknown) =>
    isRecord(value) &&
    nonempty(value.defaultModel) &&
    Array.isArray(value.environmentPrecedence) &&
    value.environmentPrecedence.every(
      (name: unknown) =>
        typeof name === "string" && /^[A-Z][A-Z0-9_]*$/.test(name),
    ) &&
    new Set(value.environmentPrecedence).size ===
      value.environmentPrecedence.length &&
    (value.trimEnvironmentValue === undefined ||
      typeof value.trimEnvironmentValue === "boolean");
  if (!Array.isArray(value) || value.length === 0)
    fail(`${context}: modelDefinitions must be a nonempty stage array.`);
  const stages = new Set<string>();
  for (const [index, stage] of value.entries()) {
    if (
      !isRecord(stage) ||
      !choice(stage) ||
      !nonempty(stage.stageId) ||
      stages.has(stage.stageId) ||
      !bilingual(stage.label) ||
      !Array.isArray(stage.failureFallbackModels) ||
      !stage.failureFallbackModels.every(choice) ||
      (stage.data !== undefined && !bilingual(stage.data)) ||
      (stage.providerNotes !== undefined && !bilingual(stage.providerNotes))
    ) {
      fail(
        `${context}: invalid model stage at index ${index}; expected a unique stageId, bilingual text, ModelChoice, and failureFallbackModels array.`,
      );
    }
    stages.add(stage.stageId);
  }
}

/** Validate everything before writing; root is injectable for isolated fixture tests. */
export async function generateTools(
  options: { root?: string; check?: boolean } = {},
) {
  const root = resolve(options.root ?? defaultRoot);
  const toolsRoot = resolve(root, "app/_tools");
  // Interpret only the release declaration and any data constants it references;
  // never execute registry helpers or import its generated compatibility exports.
  const registryPath = resolve(toolsRoot, "registry.ts");
  const registryModule = readDataModule(
    await readFile(registryPath, "utf8"),
    registryPath,
    true,
  );
  if (!Array.isArray(registryModule.appRegistryEntries))
    fail("registry.ts appRegistryEntries must be an array.");
  const entries = registryModule.appRegistryEntries as unknown as readonly {
    id: string;
    category: string;
    folder: string;
    available: boolean;
    hidden: boolean;
  }[];
  const ids = new Set<string>();
  const folders = new Set<string>();
  const routePaths = new Set<string>();
  const envNames = new Set<string>();
  const definitions: object[] = [];
  const router: Record<
    string,
    { name: string; slug: string; envName: string }
  > = {};
  const assets: { source: string; publicPath: string }[] = [];
  const outputs = new Map<string, string>();
  const clients: string[] = [];
  const modelImports: string[] = [];
  const modelEntries: string[] = [];
  const addAsset = async (
    source: string,
    publicPath: string,
    owner: string,
  ) => {
    if (!publicPath.startsWith("/"))
      fail(`${owner}: asset publicPath must start with '/'.`);
    safeRelative(publicPath.slice(1), `${owner} publicPath`);
    safeRelative(source, `${owner} source`);
    await requireOwnedFile(
      resolve(root, "app/_tools"),
      resolve(root, source),
      `${owner} asset`,
    );
    for (const existing of assets) {
      if (
        existing.publicPath === publicPath ||
        existing.publicPath.startsWith(`${publicPath}/`) ||
        publicPath.startsWith(`${existing.publicPath}/`)
      )
        fail(`${owner}: overlapping asset URL ${publicPath}.`);
    }

    assets.push({ source, publicPath });
  };

  for (const entry of entries) {
    if (!entry || typeof entry !== "object" || typeof entry.id !== "string")
      fail("registry.ts release entries must be objects with string ids.");
    const context = `tool ${entry.id}`;
    if (!/^[a-z][A-Za-z0-9]*$/.test(entry.id) || ids.has(entry.id))
      fail(`${context}: invalid or duplicate id.`);
    ids.add(entry.id);
    if (!["text", "image", "design"].includes(entry.category))
      fail(`${context}: invalid category ${entry.category}.`);
    safeRelative(entry.folder, context);
    const parts = entry.folder.split("/");
    if (
      parts.length !== 2 ||
      parts[0] !== entry.category ||
      !/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(parts[1]) ||
      folders.has(entry.folder)
    )
      fail(`${context}: folder must be a unique category/kebab-case-slug.`);
    folders.add(entry.folder);
    if (
      typeof entry.available !== "boolean" ||
      typeof entry.hidden !== "boolean"
    )
      fail(`${context}: available and hidden must be boolean.`);
    const folder = resolve(toolsRoot, entry.folder);
    await requireOwnedFile(toolsRoot, folder, context);
    for (const name of ["manifest.ts", "info.en.md", "info.cs.md", "Tool.tsx"])
      await requireOwnedFile(folder, resolve(folder, name), context);
    for (const language of ["en", "cs"]) {
      if (
        !(await readFile(resolve(folder, `info.${language}.md`), "utf8")).trim()
      )
        fail(`${context}: info.${language}.md must not be empty.`);
    }
    const manifest = (await pureModule(resolve(folder, "manifest.ts")))
      .default as ToolManifest;
    if (
      !manifest ||
      typeof manifest !== "object" ||
      !manifest.label ||
      ["en", "cs"].some(
        (lang) =>
          typeof manifest.label[lang as "en" | "cs"] !== "string" ||
          !manifest.label[lang as "en" | "cs"].trim(),
      )
    )
      fail(`${context}: manifest needs nonempty English and Czech labels.`);
    if (
      manifest.status !== undefined &&
      !["tested", "to-test", "alpha"].includes(manifest.status)
    )
      fail(`${context}: invalid status.`);
    if (
      manifest.featureFlags &&
      Object.values(manifest.featureFlags).some(
        (value) => typeof value !== "boolean",
      )
    )
      fail(`${context}: featureFlags must be boolean data.`);
    definitions.push({
      ...entry,
      label: manifest.label,
      ...(manifest.status ? { status: manifest.status } : {}),
      ...(manifest.featureFlags ? { featureFlags: manifest.featureFlags } : {}),
    });
    clients.push(
      `  ${quote(entry.id)}: lazy(() => import(${quote(`../${entry.folder}/Tool`)})),`,
    );
    if (manifest.openRouter) {
      const envName = manifest.openRouter.envName;
      if (
        [
          "OPENROUTER_MANAGEMENT_API_KEY",
          "OPENROUTER_API_KEY",
          "OPENROUTER_APP_KEY_LIMIT_USD",
          "OPENROUTER_APP_KEY_LIMIT_RESET",
        ].includes(envName)
      ) {
        fail(
          `${context}: reserved OpenRouter envName ${envName} cannot be a per-tool inference key.`,
        );
      }
      if (
        !/^OPENROUTER_[A-Z0-9_]+_API_KEY$/.test(envName) ||
        envNames.has(envName)
      )
        fail(`${context}: invalid or duplicate OpenRouter envName ${envName}.`);
      envNames.add(envName);
      router[entry.id] = { name: manifest.label.en, slug: parts[1], envName };
    }
    const modelPath = resolve(folder, "model-definitions.ts");
    if (manifest.openRouter || (await exists(modelPath))) {
      await requireOwnedFile(folder, modelPath, `${context} model definitions`);
      const metadata = await pureModule(modelPath);
      validateModelDefinitions(
        metadata.modelDefinitions,
        `${context} model-definitions.ts`,
      );
      const alias = `models${modelImports.length}`;
      modelImports.push(
        `import { modelDefinitions as ${alias} } from ${quote(`../${entry.folder}/model-definitions`)};`,
      );
      modelEntries.push(`  ${quote(entry.folder)}: ${alias},`);
    } else {
      modelEntries.push(`  ${quote(entry.folder)}: [],`);
    }
    for (const asset of manifest.assets ?? []) {
      safeRelative(asset.source, `${context} asset source`);
      await requireOwnedFile(
        folder,
        resolve(folder, asset.source),
        `${context} asset`,
      );
      await addAsset(
        `app/_tools/${entry.folder}/${asset.source}`,
        asset.publicPath,
        context,
      );
    }
    for (const route of manifest.routes ?? []) {
      if (!route.path.startsWith("/api/"))
        fail(`${context}: route path must begin /api/.`);
      safeRelative(route.path.slice(1), `${context} route path`);
      if (
        route.path
          .split("/")
          .some(
            (part) => !/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(part) && part !== "",
          )
      )
        fail(`${context}: route path must use literal kebab-case segments.`);
      if (
        /^\/api\/(auth(?:\/|$)|feedback(?:\/|$)|figures(?:\/|$))/.test(
          route.path,
        )
      )
        fail(`${context}: protected route ${route.path}.`);
      if (routePaths.has(route.path))
        fail(`${context}: duplicate route ${route.path}.`);
      routePaths.add(route.path);
      safeRelative(route.handler, `${context} handler`);
      if (
        !route.methods?.length ||
        new Set(route.methods).size !== route.methods.length ||
        route.methods.some((method) => !["GET", "POST"].includes(method))
      )
        fail(`${context}: invalid route methods for ${route.path}.`);
      if (
        route.dynamic !== undefined &&
        !["auto", "force-dynamic", "force-static"].includes(route.dynamic)
      )
        fail(`${context}: invalid dynamic config.`);
      if (
        route.runtime !== undefined &&
        !["nodejs", "edge"].includes(route.runtime)
      )
        fail(`${context}: invalid runtime config.`);
      if (
        route.revalidate !== undefined &&
        route.revalidate !== false &&
        (!Number.isInteger(route.revalidate) || route.revalidate < 0)
      )
        fail(`${context}: invalid revalidate config.`);
      if (
        route.maxDuration !== undefined &&
        (!Number.isInteger(route.maxDuration) || route.maxDuration <= 0)
      )
        fail(`${context}: maxDuration must be a positive integer.`);
      const handler = resolve(folder, `${route.handler}.ts`);
      await requireOwnedFile(folder, handler, `${context} route handler`);
      const target = resolve(root, "app", route.path.slice(1), "route.ts");
      // Check existing ancestors too: a symlink must never redirect generated writes.
      let ancestor = dirname(target);
      while (inside(root, ancestor)) {
        if (
          (await exists(ancestor)) &&
          (await lstat(ancestor)).isSymbolicLink()
        )
          fail(`${context}: route directory is a symlink.`);
        ancestor = dirname(ancestor);
      }
      const importPath = relative(dirname(target), handler)
        .split(sep)
        .join("/")
        .replace(/\.ts$/, "");
      const configs = [
        "dynamic",
        "runtime",
        "revalidate",
        "maxDuration",
      ] as const;
      const body = configs
        .filter((key) => route[key] !== undefined)
        .map((key) => `export const ${key} = ${quote(route[key])};\n`)
        .join("");
      const handlerExport = `export { ${route.methods.join(", ")} } from ${quote(importPath)};\n`;
      if (await exists(target)) {
        if ((await lstat(target)).isSymbolicLink())
          fail(`${context}: route file is a symlink.`);
        const existing = await readFile(target, "utf8");

        if (!existing.startsWith(routeMarker)) {
          // Adopt only a thin adapter that exactly matches this manifest. Never
          // overwrite an unmanaged route containing user implementation code.
          const expected = body + handlerExport;
          if (existing.replace(/\s+/g, "") !== expected.replace(/\s+/g, ""))
            fail(
              `${context}: unmanaged route collision at ${relative(root, target)}; move its implementation to the owner and explicitly adopt the adapter.`,
            );
        }
      }
      outputs.set(target, `${routeMarker}\n${body}\n${handlerExport}`);
    }
  }
  // Reference is not a sidebar tool; its established URLs remain shared assets.
  await addAsset(
    "app/_tools/design-manual/public",
    "/design-manual/downloads",
    "Design Manual",
  );
  await addAsset(
    "app/_tools/design-manual/images",
    "/design-manual/media",
    "Design Manual",
  );
  for (const category of ["text", "image", "design"]) {
    for (const dir of await readdir(resolve(toolsRoot, category), {
      withFileTypes: true,
    })) {
      if (
        dir.isDirectory() &&
        (await exists(resolve(toolsRoot, category, dir.name, "manifest.ts"))) &&
        !folders.has(`${category}/${dir.name}`)
      )
        fail(
          `Unregistered manifest: ${category}/${dir.name}. Add its release entry to registry.ts.`,
        );
    }
  }
  const generated = resolve(toolsRoot, "generated");
  outputs.set(
    resolve(generated, "registry.data.ts"),
    `${marker}\nimport type { ToolManifest } from "../types";\n\nexport const toolDefinitions = ${JSON.stringify(definitions, null, 2)} as const satisfies readonly (Pick<ToolManifest, "label" | "status" | "featureFlags"> & { id: string; category: "text" | "image" | "design"; folder: string; available: boolean; hidden: boolean })[];\n\nexport const openRouterApps = ${JSON.stringify(router, null, 2)} as const;\n`,
  );
  outputs.set(
    resolve(generated, "registry.client.tsx"),
    `${marker}\n"use client";\n\nimport { lazy, type ComponentType, type LazyExoticComponent } from "react";\nimport type { ToolProps } from "../types";\nimport type { toolDefinitions } from "./registry.data";\n\nexport const toolComponents = {\n${clients.join("\n")}\n} satisfies Record<(typeof toolDefinitions)[number]["id"], LazyExoticComponent<ComponentType<ToolProps>>>;\n`,
  );
  outputs.set(
    resolve(generated, "registry.models.ts"),
    `${marker}\nimport "server-only";\nimport type { ModelStageDefinition } from "../models";\nimport type { toolDefinitions } from "./registry.data";\n${modelImports.join("\n")}\n\nexport const modelDefinitionsByFolder: Readonly<Record<(typeof toolDefinitions)[number]["folder"], readonly ModelStageDefinition[]>> = {\n${modelEntries.join("\n")}\n};\n`,
  );
  outputs.set(
    resolve(generated, "assets.json"),
    `${JSON.stringify(
      assets.sort((a, b) => a.publicPath.localeCompare(b.publicPath)),
      null,
      2,
    )}\n`,
  );
  const stale: string[] = [];
  for (const file of await walk(resolve(root, "app/api"))) {
    if (
      file.endsWith(`${sep}route.ts`) &&
      !outputs.has(file) &&
      !(await lstat(file)).isSymbolicLink() &&
      (await readFile(file, "utf8")).startsWith(routeMarker)
    )
      stale.push(file);
  }
  const changed: string[] = [];
  if ((await exists(generated)) && (await lstat(generated)).isSymbolicLink())
    fail("Generated output directory must not be a symlink.");
  for (const [path, content] of outputs) {
    if (!(await exists(path)) || (await readFile(path, "utf8")) !== content)
      changed.push(path);
    if ((await exists(path)) && (await lstat(path)).isSymbolicLink())
      fail(`Output is a symlink: ${relative(root, path)}.`);
  }
  const assetMetadataPath = resolve(generated, "assets.json");
  const previousAssets = (await exists(assetMetadataPath))
    ? JSON.parse(await readFile(assetMetadataPath, "utf8"))
    : [];
  const assetPlan = await planPublicAssets({
    root,
    assets,
    previous: previousAssets,
    mode: "links",
  });
  const assetChanges = assetPlan.changes.map((asset) => asset.destination);
  if (assetPlan.ownershipChanged) assetChanges.push(assetPlan.ownershipPath);
  const allChanged = [...changed, ...assetChanges];
  const allRemoved = [...stale, ...assetPlan.removals];
  if (options.check) {
    if (allChanged.length || allRemoved.length)
      fail(
        `Generated output is stale: ${[...allChanged, ...allRemoved].map((path) => relative(root, path)).join(", ")}. Run node --experimental-strip-types scripts/generate-tools.mts.`,
      );
  } else {
    for (const path of changed) {
      await mkdir(dirname(path), { recursive: true });
      await writeFile(path, outputs.get(path)!);
    }
    await applyPublicAssets(assetPlan);
    for (const path of stale) await rm(path);
  }
  return {
    tools: entries.length,
    routes: routePaths.size,
    assets: assets.length,
    changed: allChanged.map((path) => relative(root, path)),
    removed: allRemoved.map((path) => relative(root, path)),
  };
}

if (
  process.argv[1] &&
  resolve(process.argv[1]) === fileURLToPath(import.meta.url)
) {
  const args = process.argv.slice(2);
  if (args.some((arg) => arg !== "--check"))
    fail(
      "Usage: node --experimental-strip-types scripts/generate-tools.mts [--check]",
    );
  console.log(
    JSON.stringify(
      await generateTools({ check: args.includes("--check") }),
      null,
      2,
    ),
  );
}
