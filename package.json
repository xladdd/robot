{
  "name": "taktik-robot",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/materialize-public-links.mjs",
    "build": "next build --webpack",
    "manual:pdf": "node app/_tools/design-manual/scripts/export-pdf.mjs",
    "openrouter:provision": "node --env-file-if-exists=.env.openrouter-management.local --experimental-strip-types app/_tools/openrouter/scripts/provision-keys.mts",
    "start": "next start",
    "test": "npm run build && node --experimental-strip-types --test tests/architecture.test.mjs tests/openrouter.test.mjs tests/translations.test.mjs app/_tools/text/index-creator/tests/index-creator.test.mts app/_tools/design/grep-builder/tests/validation.test.mts app/_tools/design/grep-builder/tests/intent.test.mts app/_tools/design/grep-builder/tests/prompt.test.mts app/_tools/design/cover-splitter/tests/cover-splitter.test.mjs app/_tools/image/graph-generator/tests/graph.test.mts app/_tools/image/diagram-generator/tests/diagram.test.mts app/_tools/image/map-generator/tests/map.test.mts app/_tools/image/image-generator/tests/prompts.test.mts app/_tools/design/solutions-importer/tests/solutions-importer.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test:figures": "node --experimental-strip-types --test app/_tools/image/graph-generator/tests/graph.test.mts app/_tools/image/diagram-generator/tests/diagram.test.mts app/_tools/image/map-generator/tests/map.test.mts",
    "diagram:eval": "node app/_tools/image/diagram-generator/scripts/run-diagram-eval.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/ces": "^1.0.0",
    "d3-geo": "^3.1.1",
    "mdast-util-to-string": "^4.0.0",
    "next": "16.2.6",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "read-excel-file": "^6.0.1",
    "remark-parse": "^11.0.0",
    "tesseract.js": "^7.0.0",
    "topojson-client": "^3.1.0",
    "unified": "^11.0.5",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/node": "22.19.19",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/topojson-client": "^3.1.5",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "pdfkit": "^0.20.2",
    "typescript": "5.9.3"
  },
  "type": "module"
}
